---
import { baseLanguage, extractLocaleOrFirst } from '@cloomba/core'

import { loadEvent, loadSpeakers, loadTicketTypes } from '@/lib/data'
import { conferenceEventNode } from '@/lib/jsonld'
import { plainText } from '@/lib/markdown'
import { locale } from '@/lib/strings'

// schema.org Event structured data — what Google builds event rich results
// from (name, dates, venue, ticket offers, speakers). Rendered on the home
// page. The node itself is built in lib/jsonld.ts, so the session pages nest
// exactly this shape as their `superEvent`.
const [event, speakers, ticketTypes] = await Promise.all([loadEvent(), loadSpeakers(), loadTicketTypes()])

const jsonLd = {
    '@context': 'https://schema.org',
    ...conferenceEventNode({
        event,
        speakers,
        ticketTypes: ticketTypes.items,
        description: plainText(event.description && extractLocaleOrFirst(event.description, baseLanguage(locale))),
    }),
}
---

<script type='application/ld+json' set:html={JSON.stringify(jsonLd)} is:inline />
