---
// The one page-title block, identical on EVERY page — top-level and detail:
// same container as the nav bar (max-w-5xl → the title sits under the logo),
// same type scale, same spacing, so navigating never moves or resizes the
// title. Detail pages pass `back`; extra header content rides in the default
// slot, and a right-side element (e.g. a speaker avatar) in slot='aside'.
interface Props {
    title: string
    subtitle?: string
    back?: { href: string; label: string }
}
const { title, subtitle, back } = Astro.props
---

<div class='mx-auto max-w-5xl px-4 pb-2 pt-10'>
    {
        back && (
            <a href={back.href} class='mb-3 inline-block text-sm text-primary hover:underline'>
                ← {back.label}
            </a>
        )
    }
    <div class='flex items-start justify-between gap-6'>
        <div class='min-w-0'>
            <h1 class='font-display text-3xl font-bold tracking-tight sm:text-4xl'>{title}</h1>
            {subtitle && <p class='mt-2 text-sm text-text-muted'>{subtitle}</p>}
            <slot />
        </div>
        <slot name='aside' />
    </div>
</div>
