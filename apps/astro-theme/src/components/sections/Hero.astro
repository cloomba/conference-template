---
import { formatDateSpan } from '@cloomba/core'

import { loadEvent } from '@/lib/data'
import { locale, t } from '@/lib/strings'

const event = await loadEvent()
const dates = formatDateSpan(
    new Date(event.starts_at),
    new Date(event.ends_at ?? event.starts_at),
    event.timezone,
    locale
)
const place = [event.location.city, event.location.country].filter(Boolean).join(', ')

// The event's cover from Cloomba wins; without one, the bundled scene keeps
// the hero from being a wall of blank surface.
const cover = event.cover_url ?? '/placeholders/hero.svg'
---

<section class='relative overflow-hidden'>
    <img draggable='false' src={cover} alt='' class='absolute inset-0 size-full object-cover' loading='eager' />
    <div class='absolute inset-0 bg-linear-to-t from-surface via-surface/70 to-surface/30'></div>
    <div class='relative mx-auto max-w-5xl px-4 pb-20 pt-24 sm:pb-28 sm:pt-32'>
        <p class='mb-3 text-sm font-semibold uppercase tracking-widest text-primary'>
            {dates}{place && ` · ${place}`}
        </p>
        <h1 class='max-w-3xl font-display text-4xl font-bold tracking-tight sm:text-6xl'>{event.title}</h1>
        <div class='mt-8 flex flex-wrap gap-3'>
            <a
                href='/tickets'
                class='rounded-card bg-primary px-6 py-3 font-medium text-primary-content transition-opacity hover:opacity-90'
            >
                {t('common.register')}
            </a>
            <a
                href='/agenda'
                class='rounded-card border border-text/15 px-6 py-3 font-medium transition-colors bg-surface hover:bg-surface-alt'
            >
                {t('hero.view_agenda')}
            </a>
        </div>
    </div>
</section>
