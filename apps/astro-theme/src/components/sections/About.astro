---
import { loadEvent } from '@/lib/data'
import { renderMarkdown } from '@/lib/markdown'
import { t } from '@/lib/strings'

// Home teaser: the description's FIRST paragraph as an [image][text] split,
// linking to the full /about page.
const event = await loadEvent()
const teaser = event.description?.split(/\n\s*\n/)[0] ?? null
---

{
    teaser && (
        <section class='mx-auto max-w-5xl px-4 py-14'>
            <div class='grid items-center gap-8 md:grid-cols-2'>
                <img
                    draggable='false'
                    src='/placeholders/venue.svg'
                    alt=''
                    class='w-full rounded-card object-cover'
                    loading='lazy'
                />
                <div>
                    <h2 class='font-display text-2xl font-semibold tracking-tight sm:text-3xl'>{t('about.heading')}</h2>
                    <div class='prose-content mt-3 text-text-muted' set:html={renderMarkdown(teaser)} />
                    <a
                        href='/about'
                        class='mt-4 inline-block rounded-card border border-text/15 px-5 py-2.5 font-medium transition-colors hover:bg-surface-alt'
                    >
                        {t('about.cta')}
                    </a>
                </div>
            </div>
        </section>
    )
}
