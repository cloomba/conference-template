---
import { getCollection, render } from 'astro:content'

import SectionHeading from '@/components/ui/SectionHeading.astro'
import { t } from '@/lib/strings'

const entries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order)
const rendered = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })))
---

{
    rendered.length > 0 && (
        <section class='mx-auto max-w-5xl px-4 py-14'>
            <SectionHeading title={t('faq.title')} />
            <div class='max-w-3xl divide-y divide-text/10 overflow-hidden rounded-card border border-text/10'>
                {rendered.map(({ entry, Content }) => (
                    <details class='group'>
                        {/* Padding lives ON the summary so the whole row —
                            edges included — is the click target. */}
                        <summary class='flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium transition-colors hover:bg-surface-alt'>
                            {entry.data.question}
                            <span class='text-text-muted transition-transform group-open:rotate-45'>+</span>
                        </summary>
                        <div class='prose-content px-5 pb-4 text-text-muted'>
                            <Content />
                        </div>
                    </details>
                ))}
            </div>
        </section>
    )
}
