---
import Base from '@/layouts/Base.astro'
---

<Base title='Page not found'>
    <div class='mx-auto max-w-5xl px-4 py-24 text-center'>
        <h1 class='font-display text-4xl font-bold tracking-tight'>Page not found</h1>
        <p class='mt-4 text-text-muted'>The page you're looking for doesn't exist or has moved.</p>
        <a
            href='/'
            class='mt-8 inline-block rounded-card bg-primary px-6 py-3 font-medium text-primary-content transition-opacity hover:opacity-90'
        >
            Back to the home page
        </a>
    </div>
</Base>
