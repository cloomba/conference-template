---
import Base from '@/layouts/Base.astro'
import { t } from '@/lib/strings'
---

<Base title={t('error.not_found_title')}>
    <div class='mx-auto max-w-5xl px-4 py-24 text-center'>
        <h1 class='font-display text-4xl font-bold tracking-tight'>{t('error.not_found_title')}</h1>
        <p class='mt-4 text-text-muted'>{t('error.not_found_body')}</p>
        <a
            href='/'
            class='mt-8 inline-block rounded-card bg-primary px-6 py-3 font-medium text-primary-content transition-opacity hover:opacity-90'
        >
            {t('error.not_found_cta')}
        </a>
    </div>
</Base>
