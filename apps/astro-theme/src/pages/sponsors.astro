---
import CallBanner from '@/components/CallBanner.astro'
import PageHeader from '@/components/PageHeader.astro'
import Sponsors from '@/components/sections/Sponsors.astro'
import Base from '@/layouts/Base.astro'
import { config } from '@/lib/config'
import { callsOpen } from '@/lib/data'
import { t } from '@/lib/strings'

const sponsorCallOpen = await callsOpen()
---

<Base title={t('nav.sponsors')} description={t('sponsors.meta_description', { site: config.site.name })}>
    <PageHeader title={t('nav.sponsors')} />
    <Sponsors plain />
    {
        sponsorCallOpen && (
            <div class='mx-auto max-w-5xl px-4 pb-8'>
                <CallBanner
                    title={t('sponsors.cta_title')}
                    body={t('sponsors.cta_body')}
                    href='/become-a-sponsor'
                    label={t('common.become_a_sponsor')}
                />
            </div>
        )
    }
</Base>
