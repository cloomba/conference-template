---
import { getCollection, render } from 'astro:content'

import PageHeader from '@/components/PageHeader.astro'
import Base from '@/layouts/Base.astro'
import { config } from '@/lib/config'

export async function getStaticPaths() {
    const posts = await getCollection('news')
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const dateFormat = new Intl.DateTimeFormat(config.site.language, { dateStyle: 'long' })
---

<Base title={post.data.title} description={post.data.description}>
    <PageHeader
        title={post.data.title}
        subtitle={dateFormat.format(post.data.date)}
        back={{ href: '/news', label: 'News' }}
    />
    <article class='mx-auto max-w-5xl px-4 py-8'>
        <div class='prose-content max-w-3xl'>
            <Content />
        </div>
    </article>
</Base>
