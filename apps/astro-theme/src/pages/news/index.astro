---
import { getCollection } from 'astro:content'

import PageHeader from '@/components/PageHeader.astro'
import Base from '@/layouts/Base.astro'
import { config } from '@/lib/config'

const posts = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const dateFormat = new Intl.DateTimeFormat(config.site.language, { dateStyle: 'long' })
---

<Base title='News'>
    <PageHeader title='News' />
    <div class='mx-auto max-w-5xl px-4 py-8'>
        <ul class='space-y-8'>
            {
                posts.map((post) => (
                    <li>
                        <a href={`/news/${post.id}`} class='group block'>
                            <time class='text-sm text-text-muted'>{dateFormat.format(post.data.date)}</time>
                            <h2 class='mt-1 font-display text-xl font-semibold group-hover:text-primary'>
                                {post.data.title}
                            </h2>
                            {post.data.description && <p class='mt-1 text-text-muted'>{post.data.description}</p>}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</Base>
