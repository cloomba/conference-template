---
import PageHeader from '@/components/PageHeader.astro'
import Tickets from '@/components/sections/Tickets.astro'
import Base from '@/layouts/Base.astro'
import { config } from '@/lib/config'
import { embedOrigin } from '@/lib/env'

// Registration runs INSIDE the Cloomba embed — the attendee signs in and pays
// on Cloomba; this site never touches auth, payments, or personal data. The
// markup below is Cloomba's OFFICIAL snippet contract: an
// `iframe.cloomba-embed` plus `/embed/embed.js`, which auto-sizes the frame to
// the content height it posts (`cloomba:embed-height`) and relays the visible
// viewport so in-frame pop-ups position correctly. Don't hand-roll listeners.
const embedSrc = `${embedOrigin}/embed/e/${encodeURIComponent(config.event.slug)}`
---

<Base title='Tickets' description={`Register for ${config.site.name}.`}>
    <PageHeader title='Tickets' />
    <Tickets plain />
    <section class='mx-auto max-w-5xl px-4 pb-16' id='register'>
        <h2 class='mb-6 font-display text-2xl font-semibold tracking-tight'>Register</h2>
        <div class='max-w-3xl overflow-hidden rounded-card border border-text/10'>
            <iframe
                class='cloomba-embed'
                src={embedSrc}
                style='width: 100%; height: 800px; border: none'
                loading='lazy'
                title={`Register for ${config.site.name}`}></iframe>
        </div>
        <script src={`${embedOrigin}/embed/embed.js`} is:inline async></script>
    </section>
</Base>
