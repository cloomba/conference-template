---
import { baseLanguage, extractLocaleOrAll } from '@cloomba/core'

import PageHeader from '@/components/PageHeader.astro'
import Team from '@/components/sections/Team.astro'
import Base from '@/layouts/Base.astro'
import { config } from '@/lib/config'
import { loadEvent } from '@/lib/data'
import { renderMarkdown } from '@/lib/markdown'
import { locale, t } from '@/lib/strings'

// The event's full description (markdown from Cloomba) — the home page shows
// only its first paragraph as a teaser. The organizing team ALWAYS renders
// here (no cutoff — unlike the call banners). A description with a section per
// language shows the preamble plus the site's language.
const event = await loadEvent()
const description = event.description ? extractLocaleOrAll(event.description, baseLanguage(locale)) : null
---

<Base title={t('nav.about')} description={config.site.description}>
    <PageHeader title={t('about.page_title', { site: config.site.name })} />
    <article class='mx-auto max-w-5xl px-4 py-8'>
        {description && <div class='prose-content max-w-3xl' set:html={renderMarkdown(description)} />}
    </article>
    <Team />
</Base>
