---
import { formatDayHeading, formatTimeRange } from '@cloomba/core'

import PageHeader from '@/components/PageHeader.astro'
import SocialLink from '@/components/ui/SocialLink.astro'
import Base from '@/layouts/Base.astro'
import { config } from '@/lib/config'
import { loadEvent, loadSessions, loadSpeakers } from '@/lib/data'
import { renderMarkdown } from '@/lib/markdown'
import { detailSlug, sessionPath } from '@/lib/slugs'

export async function getStaticPaths() {
    const speakers = await loadSpeakers()
    return speakers.map((speaker) => ({
        params: { slug: detailSlug(speaker.name, speaker.hash) },
        props: { speaker },
    }))
}

const { speaker } = Astro.props
const [event, sessions] = await Promise.all([loadEvent(), loadSessions()])
const own = sessions.filter((session) => session.speakers.some((s) => s.hash === speaker.hash))
const locale = config.site.language

// Person structured data for search.
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: speaker.name ?? undefined,
    jobTitle: speaker.headline ?? undefined,
    image: speaker.image_url ?? undefined,
    ...(speaker.link ? { sameAs: [speaker.link] } : {}),
    ...(speaker.bio ? { description: speaker.bio } : {}),
}
---

<Base title={speaker.name ?? 'Speaker'}>
    <script type='application/ld+json' set:html={JSON.stringify(jsonLd)} is:inline />
    <PageHeader
        title={speaker.name ?? 'Speaker'}
        subtitle={speaker.headline ?? undefined}
        back={{ href: '/speakers', label: 'Speakers' }}
    >
        {
            speaker.link && (
                <div class='mt-3'>
                    <SocialLink href={speaker.link} />
                </div>
            )
        }
        {
            speaker.image_url ? (
                <img
                    slot='aside'
                    draggable='false'
                    src={speaker.image_url}
                    alt={speaker.name ?? ''}
                    class='size-20 shrink-0 rounded-card object-cover sm:size-28'
                />
            ) : (
                <div
                    slot='aside'
                    class='flex size-20 shrink-0 items-center justify-center rounded-card bg-surface-alt font-display text-3xl text-text-muted sm:size-28'
                >
                    {(speaker.name ?? '?').slice(0, 1)}
                </div>
            )
        }
    </PageHeader>
    <article class='mx-auto max-w-5xl px-4 py-8'>
        {speaker.bio && <div class='prose-content max-w-3xl' set:html={renderMarkdown(speaker.bio)} />}

        {
            own.length > 0 && (
                <section class='mt-10'>
                    <h2 class='mb-4 font-display text-xl font-semibold'>Sessions</h2>
                    <ol class='max-w-3xl divide-y divide-text/10 overflow-hidden rounded-card border border-text/10'>
                        {own.map((session) => (
                            <li>
                                <a href={sessionPath(session)} class='block px-4 py-3 hover:bg-surface-alt'>
                                    <span class='font-mono text-xs text-text-muted'>
                                        {formatDayHeading(session.starts_at, event.timezone, locale)} ·{' '}
                                        {formatTimeRange(session.starts_at, session.ends_at, event.timezone, locale)}
                                        {session.location && ` · ${session.location}`}
                                    </span>
                                    <span class='mt-1 block font-medium'>{session.title}</span>
                                </a>
                            </li>
                        ))}
                    </ol>
                </section>
            )
        }
    </article>
</Base>
