---
import CallBanner from '@/components/CallBanner.astro'
import PageHeader from '@/components/PageHeader.astro'
import Base from '@/layouts/Base.astro'
import { config } from '@/lib/config'
import { callsOpen, loadSpeakers } from '@/lib/data'
import { speakerPath } from '@/lib/slugs'
import { t } from '@/lib/strings'

const speakers = await loadSpeakers()
const cfpOpen = await callsOpen()
---

<Base title={t('nav.speakers')} description={t('speakers.meta_description', { site: config.site.name })}>
    <PageHeader title={t('nav.speakers')} />
    <div class='mx-auto max-w-5xl px-4 py-8'>
        <ul class='grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4'>
            {
                speakers.map((speaker) => (
                    <li>
                        <a href={speakerPath(speaker)} class='group block'>
                            <div class='mb-3 overflow-hidden rounded-card transition duration-300 group-hover:shadow-lg group-hover:shadow-primary/15 motion-safe:group-hover:-translate-y-1'>
                                {speaker.image_url ? (
                                    <img
                                        draggable='false'
                                        src={speaker.image_url}
                                        alt={speaker.name ?? ''}
                                        class='aspect-square w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105'
                                        loading='lazy'
                                    />
                                ) : (
                                    <div class='flex aspect-square w-full items-center justify-center bg-surface-alt font-display text-3xl text-text-muted'>
                                        {(speaker.name ?? '?').slice(0, 1)}
                                    </div>
                                )}
                            </div>
                            <h2 class='font-medium group-hover:text-primary'>{speaker.name}</h2>
                            {speaker.headline && <p class='mt-0.5 text-sm text-text-muted'>{speaker.headline}</p>}
                        </a>
                    </li>
                ))
            }
        </ul>
        {
            cfpOpen && (
                <CallBanner
                    title={t('speakers.cfp_title')}
                    body={t('speakers.cfp_body')}
                    href='/call-for-papers'
                    label={t('speakers.cfp_label')}
                />
            )
        }
    </div>
</Base>
