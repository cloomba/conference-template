# Cloomba public API — create a free read-only key at
# https://cloomba.com/me/developers
CLOOMBA_API_KEY=cloomba_sk_your_key_here

# Optional overrides — production defaults live in site.config.ts (api.*).
# Uncomment for local development against a dev Cloomba stack:
# CLOOMBA_API_URL=http://localhost:3070/public/v1
# CLOOMBA_BROWSER_API_URL=http://localhost:3070/v1
# CLOOMBA_EMBED_ORIGIN=http://localhost:3000
