# Astro reads .env from apps/astro-theme/, not from here — see
# apps/astro-theme/.env.example, which is the one that matters. This file
# exists for tooling run from the repository root.
#
# Neither is required to try the template: with no key set, the build falls
# back to a shared read-only key against the demo conference.
CLOOMBA_API_KEY=cloomba_sk_your_key_here
CLOOMBA_API_URL=https://api.cloomba.com/public/v1
