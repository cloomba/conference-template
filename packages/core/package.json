{
    "name": "@cloomba/core",
    "version": "0.1.0",
    "description": "Site-config schema and pure domain logic for the Cloomba conference template",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/cloomba/conference-template",
        "directory": "packages/core"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    }
}
