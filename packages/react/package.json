{
    "name": "@cloomba/react",
    "version": "0.1.0",
    "description": "React bindings for the Cloomba conference template — thin adapters over @cloomba/core",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/cloomba/conference-template",
        "directory": "packages/react"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts --clean --external react,@cloomba/core",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@cloomba/core": "*"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@types/react": "^19.2.18",
        "react": "^19.2.8",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3"
    }
}
