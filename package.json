{
    "name": "conference-template",
    "private": true,
    "license": "MIT",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "packageManager": "yarn@1.22.22",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "yarn workspaces run build",
        "typecheck": "yarn workspaces run typecheck",
        "lint": "eslint packages",
        "format": "prettier --write \"packages/*/src/**/*.ts\" \"apps/*/src/**/*.{ts,tsx,astro}\""
    },
    "prettier": {
        "useTabs": false,
        "singleQuote": true,
        "jsxSingleQuote": true,
        "semi": false,
        "tabWidth": 4,
        "printWidth": 120,
        "quoteProps": "preserve",
        "bracketSameLine": false,
        "arrowParens": "always",
        "trailingComma": "es5",
        "plugins": [
            "@ianvs/prettier-plugin-sort-imports",
            "prettier-plugin-astro"
        ],
        "importOrder": [
            "<BUILTIN_MODULES>",
            "<THIRD_PARTY_MODULES>",
            "",
            "^(@/)(.*)$",
            "",
            "^[.]"
        ]
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "eslint": "^10.9.1",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0"
    }
}
